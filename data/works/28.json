=\"work-detail__actions\" data-work-detail-actions hidden></div>\n\t\t\t\n\t\t</aside>\n\t\t\n\n\t\t\n\t\t<div class=\"wp-block-group work-detail__main is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\n\t\t\t<div class=\"wp-block-group work-detail__header is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\t<p class=\"work-detail__eyebrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 18 12\" aria-hidden=\"true\" focusable=\"false\"><g fill=\"currentColor\"><circle cx=\"2.5\" cy=\"2\" r=\"1.35\"/><circle cx=\"6.8\" cy=\"2\" r=\"1.35\" opacity=\".45\"/><circle cx=\"11.1\" cy=\"2\" r=\"1.35\" opacity=\".8\"/><circle cx=\"15.4\" cy=\"2\" r=\"1.35\" opacity=\".3\"/><circle cx=\"2.5\" cy=\"6\" r=\"1.35\" opacity=\".6\"/><circle cx=\"6.8\" cy=\"6\" r=\"1.35\"/><circle cx=\"11.1\" cy=\"6\" r=\"1.35\" opacity=\".35\"/><circle cx=\"15.4\" cy=\"6\" r=\"1.35\" opacity=\".9\"/><circle cx=\"2.5\" cy=\"10\" r=\"1.35\" opacity=\".5\"/><circle cx=\"6.8\" cy=\"10\" r=\"1.35\" opacity=\".7\"/><circle cx=\"11.1\" cy=\"10\" r=\"1.35\"/><circle cx=\"15.4\" cy=\"10\" r=\"1.35\" opacity=\".4\"/></g></svg><span>LIVE</span><i></i><span>2025</span></p>\n\t\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">《KINGDOM》 趙亭婷x安娜琪舞蹈劇場</h1><script type=\"application/json\" data-work-share-source>{\"url\":\"/works/kingdom/\",\"title\":\"\\u300aKINGDOM\\u300b \\u8d99\\u4ead\\u5a77x\\u5b89\\u5a1c\\u742a\\u821e\\u8e48\\u5287\\u5834\",\"category\":\"LIVE\",\"year\":\"2025\",\"cover\":\"/wp-content/uploads/2026/08/kingdom-cover.webp\",\"roles\":[\"\\u8072\\u97f3\\u57f7\\u884c\"]}</script>\n\t\t\t</div>\n\t\t\t\n\n\t\t\t<section class=\"work-detail__section work-detail__section--description\" data-work-detail-section=\"ABOUT\" aria-labelledby=\"work-detail-section-description-28\"><h2 class=\"work-detail__label\" id=\"work-detail-section-description-28\"><span class=\"work-detail__label-text\">ABOUT</span></h2><div class=\"work-detail__section-body\"><div class=\"work-detail__post-content work-detail__description\"><h2 class=\"wp-block-heading screen-reader-text\">Description</h2>\n<p class=\"wp-block-paragraph\">在虛擬世界中，空間與時間被切割、壓縮與延展，彷彿成了一層層可被讀取的切片，身體不再有固定的位置，而是跟隨著失衡的記憶斷層，懸浮在虛實之間。</p>\n\n<p class=\"wp-block-paragraph\">身處於網路與數位技術高速發展的世代，我們早已熟練地運用各式媒介捕捉與記錄周遭事物。然而，在這樣不斷更新的洪流中，《KINGDOM》正試圖邀請觀眾，一同回望那些被遺落、被忽視、被淘汰的事物。那些日常的顯而易見，正是我們不曾記得的，也正是如此它長出了自己的個性、色調與溫度。</p>\n\n<p class=\"wp-block-paragraph\">《KINGDOM》是一場XR跨域共構的實驗性表演作品，結合了3D掃描技術與動態捕捉系統於VR之中，透過現場多螢幕的拼湊與舞者的身體語彙，將破碎、液化且不完整的物件掃描檔案，構築出一座無人居住的數位王國，在不斷崩解與重組的數位環境裡，不停地適應新的認知與環境。</p>\n</div></div></section>\n\t\t\t\n\t\t\t<section class=\"work-detail__section work-detail__section--watch\" data-work-detail-section=\"WATCH\" aria-labelledby=\"work-detail-section-watch-28\"><h2 class=\"work-detail__label\" id=\"work-detail-section-watch-28\"><span class=\"work-detail__label-text\">WATCH</span></h2><div class=\"work-detail__section-body\"><div class=\"work-media work-media--watch\"><section class=\"work-media__section work-media-embed work-media-embed--youtube\" aria-labelledby=\"work-media-youtube-28\"><h2 id=\"work-media-youtube-28\" class=\"work-media__heading\">Video</h2><div class=\"work-media-embed__frame work-media-embed__frame--youtube\"><button type=\"button\" class=\"work-youtube\" data-youtube-id=\"_y70YY5ATW0\" data-youtube-src=\"https://www.youtube.com/embed/_y70YY5ATW0\" data-youtube-title=\"《KINGDOM》 趙亭婷x安娜琪舞蹈劇場 — YouTube video\" aria-label=\"Play video: 《KINGDOM》 趙亭婷x安娜琪舞蹈劇場\"><img class=\"work-youtube__poster\" src=\"https://i.ytimg.com/vi/_y70YY5ATW0/maxresdefault.jpg\" data-youtube-fallback=\"https://i.ytimg.com/vi/_y70YY5ATW0/hqdefault.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\"><span class=\"work-youtube__play\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" focusable=\"false\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></span></button><noscript><a class=\"work-youtube__link\" href=\"https://www.youtube.com/watch?v=_y70YY5ATW0\" target=\"_blank\" rel=\"noopener noreferrer\">Watch on YouTube: 《KINGDOM》 趙亭婷x安娜琪舞蹈劇場</a></noscript></div></section></div></div></section>\n\t\t\t<section class=\"work-detail__section work-detail__section--credits\" data-work-detail-section=\"CREDITS\" aria-labelledby=\"work-detail-section-credits-28\"><h2 class=\"work-detail__label\" id=\"work-detail-section-credits-28\"><span class=\"work-detail__label-text\">CREDITS</span></h2><div class=\"work-detail__section-body\"><section class=\"work-detail__credits\" aria-labelledby=\"work-detail-credits-28\"><h2 id=\"work-detail-credits-28\" class=\"work-media__heading\">Credits</h2><dl id=\"work-credits-list-28\" class=\"work-credits work-credits--long is-collapsed\"><div class=\"work-credits__row\"><dt>概念及編舞／演出</dt><dd>趙亭婷</dd></div>\n<div class=\"work-credits__row\"><dt>VR影像內容暨互動設計</dt><dd>鄭伊婷</dd></div>\n<div class=\"work-credits__row\"><dt>VR技術工程</dt><dd>柯柏羽</dd></div>\n<div class=\"work-credits__row\"><dt>VR場景設計</dt><dd>許子安</dd></div>\n<div class=\"work-credits__row\"><dt>空間設計</dt><dd>江冠男</dd></div>\n<div class=\"work-credits__row\"><dt>燈光設計</dt><dd>王宥珺</dd></div>\n<div class=\"work-credits__row\"><dt>聲響設計</dt><dd>張欣語</dd></div>\n<div class=\"work-credits__row\"><dt>服裝設計</dt><dd>郭萱</dd></div>\n<div class=\"work-credits__row\"><dt>舞台監督</dt><dd>洪伊柔</dd></div>\n<div class=\"work-credits__row\"><dt>影像技術統籌</dt><dd>吳承儒</dd></div>\n<div class=\"work-credits__row\"><dt>影像技術執行</dt><dd>李芷萱</dd></div>\n<div class=\"work-credits__row\"><dt>燈光技術指導</dt><dd>梁弘岳</dd></div>\n<div class=\"work-credits__row\"><dt>舞台技術指導</dt><dd>沈承志</dd></div>\n<div class=\"work-credits__row\"><dt>聲音執行</dt><dd>陳柏豪</dd></div>\n<div class=\"work-credits__row\"><dt>創作陪伴</dt><dd>黃美寧</dd></div>\n<div class=\"work-credits__row\"><dt>創作顧問</dt><dd>謝杰樺</dd></div>\n<div class=\"work-credits__row\"><dt>科技技術顧問</dt><dd>陳韋安</dd></div>\n<div class=\"work-credits__row\"><dt>藝術與企業合作暨永續顧問</dt><dd>潘思廷</dd></div>\n<div class=\"work-credits__row\"><dt>製作人</dt><dd>戴筱凡</dd></div>\n<div class=\"work-credits__row\"><dt>專案票務與行政協力</dt><dd>楊舒涵</dd></div>\n<div class=\"work-credits__row\"><dt>主視覺設計</dt><dd>徐紹恩</dd></div>\n<div class=\"work-credits__row\"><dt>平面攝影</dt><dd>林峻永、林蔚圻（階段性呈現）</dd></div>\n<div class=\"work-credits__row\"><dt>動態攝影</dt><dd>駱思維</dd></div>\n<div class=\"work-credits__row\"><dt>製作單位</dt><dd>安娜琪舞蹈劇場</dd></div>\n<div class=\"work-credits__row\"><dt>贊助單位</dt><dd>革蘭科技股份有限公司、文化部、台北市政府文化局、菁霖文化藝術基金會</dd></div>\n<div class=\"work-credits__row\"><dt>合作單位</dt><dd>C-LAB臺灣聲響實驗室、臺北數位藝術媒合平台、財團法人工業技術研究院</dd></div>\n</dl><ul class=\"work-credits__notes\"><li>本演出由114年文化部「扶植青年藝術發展補助」支持</li><li>安娜琪舞蹈劇場為 2025TAIWAN TOP演藝團隊</li></ul><button type=\"button\" class=\"work-credits__toggle\" data-work-credits-toggle aria-controls=\"work-credits-list-28\" aria-expanded=\"false\" data-label-more=\"顯示全部 26 位\" data-label-less=\"收合\">顯示全部 26 位</button></section></div></section>\n\t\t\t<section class=\"work-detail__section work-detail__section--gallery\" data-work-detail-section=\"GALLERY\" aria-labelledby=\"work-detail-section-gallery-28\"><h2 class=\"work-detail__label\" id=\"work-detail-section-gallery-28\"><span class=\"work-detail__label-text\">GALLERY</span></h2><div class=\"work-detail__section-body\"><div class=\"work-media work-media--gallery\"><section class=\"work-media__section work-media-gallery\" aria-labelledby=\"work-media-gallery-28\"><h2 id=\"work-media-gallery-28\" class=\"work-media__heading\">Gallery</h2><div class=\"work-media-gallery__grid\"><figure class=\"work-media-gallery__item\" style=\"--work-gallery-ratio: 0.8000\"><a class=\"work-media-gallery__link\" href=\"/wp-content/uploads/2026/08/1uQKc_JlBP-EuOUAkVnM9wVMZYwar931n.webp\" data-work-gallery-item data-work-gallery-index=\"0\" data-work-gallery-count=\"6\" aria-haspopup=\"dialog\" aria-label=\"Open image 1 of 6: 《KINGDOM》 趙亭婷x安娜琪舞蹈劇場 — SnapInsta.to_571413236_841694015179750_2582012147598559308_n.jpg\"><img width=\"819\" height=\"1024\" src=\"/wp-content/uploa
  "html": "\n\n<div class=\"wp-block-group alignfull work-detail has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n\t\n\t<div class=\"wp-block-group alignwide work-detail__layout is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\n\t\t<div class=\"wp-block-group work-detail__header is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">神魔之塔十二週年主題曲《星恆相伴》</h1>\n\t\t\t<div class=\"taxonomy-work_category work-detail__categories wp-block-post-terms\"><a href=\"/work-category/music/\" rel=\"tag\">MUSIC</a></div>\n\t\t\t\n\t\t\t<p class=\"work-detail__year work-year wp-block-paragraph\">2025</p>\n\t\t\t\n\t\t</div>\n\t\t\n\n\t\t<figure data-cover-orientation=\"square\" class=\"work-detail__hero wp-block-post-featured-image\"><img width=\"1254\" height=\"1254\" src=\"/wp-content/uploads/2026/08/tower-of-saviors-12th-cover.webp\" class=\"attachment-full size-full wp-post-image\" alt=\"神魔之塔十二週年主題曲《星恆相伴》\" style=\"object-fit:cover;\" decoding=\"async\" loading=\"lazy\" srcset=\"/wp-content/uploads/2026/08/tower-of-saviors-12th-cover.webp 1254w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-300x300.webp 300w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-1024x1024.webp 1024w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-150x150.webp 150w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-768x768.webp 768w\" sizes=\"auto, (max-width: 1254px) 100vw, 1254px\" /></figure>\n\n\t\t\n\t\t<div class=\"wp-block-group work-detail__content has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n\t\t\t<div class=\"entry-content work-detail__post-content wp-block-post-content has-global-padding is-layout-constrained wp-block-post-content-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Credits</h2>\n\n\n\n<ul class=\"wp-block-list\">\n\n<li>主唱 | Ruka Banana、吳是閎、54Red</li>\n\n\n<li>粵語友情配唱 | 佳龍 Gary、Molly@TOS</li>\n\n\n<li>歌曲製作人 | Aaron Aranas</li>\n\n\n<li>監製 | Rain Lui、Leona Lee</li>\n\n\n<li>作詞 | 郭沛昱</li>\n\n\n<li>作曲 | Aaron Aranas</li>\n\n\n<li>編曲 | Aaron Aranas、陳柏豪</li>\n\n\n<li>合聲編寫 | 陳柏豪</li>\n\n\n<li>配唱製作人 | 陳柏豪</li>\n\n\n<li>人聲器樂錄音師 | 李晨安</li>\n\n\n<li>人聲處理 | 陳柏豪</li>\n\n\n<li>錄音室 | 智冠錄音室</li>\n\n\n<li>手風琴演奏 | 陳沛彣</li>\n\n\n<li>中提琴演奏 | 林楷訓</li>\n\n\n<li>低音大提琴演奏 | 邱宇君</li>\n\n\n<li>電吉他 木吉他 電貝斯演奏 | 陳柏豪</li>\n\n\n<li>製譜 | 陽惟恩 Wayne Yang</li>\n\n\n<li>混音工程師 | 陳柏豪</li>\n\n\n<li>母帶後期處理工程師 | 陳柏豪</li>\n\n</ul>\n\n\n</div>\n\t\t\t<div class=\"work-media\"><section class=\"work-media__section work-detail-audio\" data-work-detail-audio data-playlist-work-id=\"88\" data-playlist-title=\"神魔之塔十二週年主題曲《星恆相伴》\" aria-labelledby=\"work-detail-audio-88\"><h2 id=\"work-detail-audio-88\" class=\"work-detail-audio__title\">神魔之塔十二週年主題曲《星恆相伴》</h2><div class=\"work-detail-audio__now\"><img width=\"1024\" height=\"1024\" src=\"/wp-content/uploads/2026/08/tower-of-saviors-12th-cover-1024x1024.webp\" class=\"work-detail-audio__artwork\" alt=\"神魔之塔十二週年主題曲《星恆相伴》\" loading=\"lazy\" decoding=\"async\" srcset=\"/wp-content/uploads/2026/08/tower-of-saviors-12th-cover-1024x1024.webp 1024w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-300x300.webp 300w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-150x150.webp 150w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover-768x768.webp 768w, /wp-content/uploads/2026/08/tower-of-saviors-12th-cover.webp 1254w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /><div class=\"work-detail-audio__current\"><p class=\"work-detail-audio__eyebrow\">NOW PLAYING</p><p class=\"work-detail-audio__current-title\">星恆相伴</p><div class=\"work-detail-audio__controls\"><div class=\"work-detail-audio__transport\" role=\"group\" aria-label=\"Playback controls\"><button type=\"button\" data-work-detail-audio-action=\"previous\" aria-label=\"Previous track\">◀</button><button type=\"button\" data-work-detail-audio-action=\"play\" aria-label=\"Play\" aria-pressed=\"false\">▶</bu
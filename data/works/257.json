  "html": "\n\n<div class=\"wp-block-group alignfull work-detail has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n\t\n\t<div class=\"wp-block-group alignwide work-detail__layout is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\n\t\t<div class=\"wp-block-group work-detail__aside is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t<figure data-cover-orientation=\"landscape\" class=\"work-detail__hero wp-block-post-featured-image\"><img width=\"1448\" height=\"1086\" src=\"/wp-content/uploads/2026/09/PHC-Recorder-Cover.png\" class=\"attachment-full size-full wp-post-image\" alt=\"PHC Recorder cover showing the audio recording interface\" style=\"object-fit:cover;\" decoding=\"async\" srcset=\"/wp-content/uploads/2026/09/PHC-Recorder-Cover.png 1448w, /wp-content/uploads/2026/09/PHC-Recorder-Cover-300x225.png 300w, /wp-content/uploads/2026/09/PHC-Recorder-Cover-1024x768.png 1024w, /wp-content/uploads/2026/09/PHC-Recorder-Cover-768x576.png 768w\" sizes=\"(max-width: 1448px) 100vw, 1448px\" loading=\"eager\" fetchpriority=\"high\" /></figure>\n\n\t\t\t\n\t\t\t<div class=\"wp-block-group work-detail__metadata is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\t\n\t\t\t\t<div class=\"wp-block-group work-detail__metadata-row work-detail__metadata-row--year is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\t\t\n\t\t\t\t\t<p class=\"work-detail__metadata-label wp-block-paragraph\">YEAR</p>\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t<p class=\"work-detail__year work-year work-detail__metadata-value wp-block-paragraph\">2026</p>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\n\t\t\t\t\n\t\t\t\t<div class=\"wp-block-group work-detail__metadata-row work-detail__metadata-row--type is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\t\t\n\t\t\t\t\t<p class=\"work-detail__metadata-label wp-block-paragraph\">TYPE</p>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"taxonomy-work_category work-detail__categories work-detail__metadata-value wp-block-post-terms\"><a href=\"/work/\" rel=\"tag\">LAB</a></div>\n\t\t\t\t</div>\n\t\t\t\t\n\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\n\t\t\t\n\t\t</div>\n\t\t\n\n\t\t\n\t\t<div class=\"wp-block-group work-detail__main is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\n\t\t\t<div class=\"wp-block-group work-detail__header is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">PHC Recorder</h1><div class=\"work-ctas\" role=\"group\" aria-label=\"Project links\"><div class=\"work-cta-group work-cta-group--download\" role=\"group\" aria-label=\"Downloads\"><span class=\"work-cta-group__icon\" title=\"Download\"><svg class=\"work-cta__icon work-cta__icon--download\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><a class=\"work-cta work-cta--download\" href=\"https://github.com/p-haochen/phc-recorder/releases/download/v1.0.1/phc.recorder-v1.0.1.zip\" target=\"_blank\" rel=\"noopener noreferrer\" data-work-cta-type=\"download\" aria-label=\"Download\"><span>DOWNLOAD</span></a></div><a class=\"work-cta work-cta--github work-cta--icon\" href=\"https://github.com/p-haochen/phc-recorder\" target=\"_blank\" rel=\"noopener noreferrer\" data-work-cta-type=\"github\" aria-label=\"GitHub\" title=\"GitHub\"><svg class=\"work-cta__icon work-cta__icon--github\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"currentColor\" d=\"M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.95c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.2 10.2 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z\"/></svg><span class=\"screen-reader-text\">GITHUB</span></a></div>\n\t\t\t</div>\n\t\t\t\n\n\t\t\t<div class=\"work-detail__post-content work-detail__description\"><p class=\"wp-block-paragraph\">PHC Recorder is a free and open-source multichannel recording utility for Cycling ’74 Max, supporting 1–64 channels with synchronized mono or interleaved WAV recording.</p><p class=\"wp-block-paragraph\">PHC Recorder began as a reusable recording module for my own multichannel Max/MSP performance and installation workflows. It was later developed into a standalone package that can be reused across projects and shared with the Max community.</p></div>\n\t\t\t<section class=\"work-detail__credits\" aria-labelledby=\"work-detail-credits-257\"><h2 id=\"work-detail-credits-257\" class=\"work-media__heading\">Credits</h2><dl id=\"work-credits-list-257\" class=\"work-credits\"><div class=\"work-credits__row\"><dt>Concept / Design / Development</dt><dd>PO HAO CHEN</dd></div></dl></section>\n\t\t\t\n\t\t</div>\n\t\t\n\t</div>\n\t\n\n\t\n\t<div class=\"wp-block-group alignwide work-detail__footer is-layout-flow wp-block-group-is-layout-flow\">\n\t\t<div class=\"work-media work-media--gallery\"><section class=\"work-media__section work-media-gallery work-media-gallery--phc-recorder\" aria-labelledby=\"work-media-gallery-257\"><h2 id=\"work-media-gallery-257\" class=\"work-media__heading\">Gallery</h2><div class=\"work-media-gallery__grid\"><figure class=\"work-media-gallery__item\" style=\"--work-gallery-ratio: 1.3333\"><a class=\"work-media-gallery__link\" href=\"/wp-content/uploads/2026/09/attachment1-20260923.webp\" data-work-gallery-item data-work-gallery-index=\"0\" data-work-gallery-count=\"2\" aria-haspopup=\"dialog\" aria-label=\"Open image 1 of 2: PHC Recorder product overview with recording interface, features, and multichannel controls\"><img width=\"1024\" height=\"768\" src=\"/wp-content/uploads/2026/09/attachment1-20260923-1024x768.webp\" class=\"work-media-gallery__image\" alt=\"PHC Recorder product overview with recording interface, features, and multichannel controls\" loading=\"lazy\" decoding=\"async\" sizes=\"auto, (max-width: 760px) calc(100vw - 2rem), (max-width: 1599px) 45vw, 720px\" srcset=\"/wp-content/uploads/2026/09/attachment1-20260923-1024x768.webp 1024w, /wp-content/uploads/2026/09/attachment1-20260923-300x225.webp 300w, /wp-content/uploads/2026/09/attachment1-20260923-768x576.webp 768w, /wp-content/uploads/2026/09/attachment1-20260923.webp 1448w\" /></a></figure><figure class=\"work-media-gallery__item\" style=\"--work-gallery-ratio: 1.0485\"><a class=\"work-media-gallery__link\" href=\"/wp-content/uploads/2026/09/PHC-Recorder-Interface.webp\" data-work-gallery-item data-work-gallery-index=\"1\" data-work-gallery-count=\"2\" aria-haspopup=\"dialog\" aria-label=\"Open image 2 of 2: PHC Recorder 16-channel interleaved recording interface\"><img width=\"800\" height=\"763\" src=\"/wp-content/uploads/2026/09/PHC-Recorder-Interface.webp\" class=\"work-media-gallery__image\" alt=\"PHC Recorder 16-channel interleaved recording interface\" loading=\"lazy\" decoding=\"async\" sizes=\"auto, (max-width: 760px) calc(100vw - 2rem), (max-width: 1599px) 45vw, 720px\" srcset=\"/wp-content/uploads/2026/09/PHC-Recorder-Interface.webp 800w, /wp-content/uploads/2026/09/PHC-Recorder-Interface-300x286.webp 300w, /wp-content/uploads/2026/09/PHC-Recorder-Interface-768x732.webp 768w\" /></a></figure></div></section></div>\n\t\t\n\t\t<p class=\"portfolio-copyright work-detail__copyright wp-block-paragraph\">Media © respective rights holders. All rights reserved.</p>\n\t\t\n\t</div>\n\t\n</div>\n\n",

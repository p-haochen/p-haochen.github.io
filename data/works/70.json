  "html": "\n\n<div class=\"wp-block-group alignfull work-detail has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n\t\n\t<div class=\"wp-block-group alignwide work-detail__layout is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\n\t\t<div class=\"wp-block-group work-detail__header is-layout-flow wp-block-group-is-layout-flow\">\n\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">【White Days】〈純白和弦〉塔芭絲可聯動主題曲</h1>\n\t\t\t<div class=\"taxonomy-work_category work-detail__categories wp-block-post-terms\"><a href=\"/work-category/music/\" rel=\"tag\">MUSIC</a></div>\n\t\t\t\n\t\t\t<p class=\"work-detail__year work-year wp-block-paragraph\">2023</p>\n\t\t\t\n\t\t</div>\n\t\t\n\n\t\t<figure data-cover-orientation=\"square\" class=\"work-detail__hero wp-block-post-featured-image\"><img width=\"676\" height=\"676\" src=\"/wp-content/uploads/2026/08/white-days-cover.webp\" class=\"attachment-full size-full wp-post-image\" alt=\"【White Days】〈純白和弦〉塔芭絲可聯動主題曲\" style=\"object-fit:cover;\" decoding=\"async\" loading=\"lazy\" srcset=\"/wp-content/uploads/2026/08/white-days-cover.webp 676w, /wp-content/uploads/2026/08/white-days-cover-300x300.webp 300w, /wp-content/uploads/2026/08/white-days-cover-150x150.webp 150w\" sizes=\"auto, (max-width: 676px) 100vw, 676px\" /></figure>\n\n\t\t\n\t\t<div class=\"wp-block-group work-detail__content has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n\t\t\t<div class=\"entry-content work-detail__post-content wp-block-post-content has-global-padding is-layout-constrained wp-block-post-content-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Credits</h2>\n\n\n\n<ul class=\"wp-block-list\">\n\n<li>作詞｜郭沛昱</li>\n\n\n<li>作曲｜Aaron Aranas</li>\n\n\n<li>編曲｜Aaron Aranas、陳柏豪</li>\n\n\n<li>合聲編寫｜Aaron Aanas</li>\n\n\n<li>合音演唱｜可蕾</li>\n\n\n<li>配唱製作人｜李晨安、Aaron Aranas</li>\n\n\n<li>人聲處理｜李晨安、陳柏豪</li>\n\n\n<li>電吉他、木吉他、電貝斯演奏｜陳柏豪</li>\n\n\n<li>混音工程師｜陳柏豪</li>\n\n\n<li>母帶後期處理工程師｜陳柏豪</li>\
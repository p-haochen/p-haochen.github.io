\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">神魔之塔《星恆相伴》12 週年主題曲（編曲、吉他／貝斯、配唱、錄音、混音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">台鋼獵鷹主題曲《鷹速飛翔》（製作人、編曲、吉他／貝斯、配唱、錄音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">黑熊合唱團單曲〈Dream〉（製作人、編曲、吉他／貝斯、錄音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">《Waiting 路燈時間》短片配樂（作曲、編曲、混音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">全息烏托邦計畫《80之後》配樂（作曲、編曲、聲音設計、混音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">台鋼天鷹主題曲（編曲、錄音、吉他／貝斯、配唱、混音）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">聲響藝術節新銳當代音樂聲響聯合展演《Boulder 石》（電子音樂演奏）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2025</strong><span class=\"cv-experience__description\">趙亭婷 × 安娜琪舞蹈劇場《KINGDOM》（聲音執行）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2026</strong><span class=\"cv-experience__description\">E1and Special Showcase《WONDE1AND》（音樂總監、Programmer、Band Leader、音樂編曲）</span></li>\n\t\t\t<li class=\"cv-experience__row\"><strong class=\"cv-experience__year\">2026</strong><span class=\"cv-experience__description\">金V獎主題曲（配唱製作人）</span></li>\n\t\t\t</ul>\n\t\t\t\n\t\t</div>\n\t\t\n\t</div>\n\t\n</div>\n\n",

  "html": "\r\n\r\n<div class=\"wp-block-group alignfull prototype-main about-prototype has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\r\n\t\r\n\t<div class=\"wp-block-group alignwide editorial-section editorial-grid is-layout-flow wp-block-group-is-layout-flow\">\r\n\t\t\r\n\t\t<h1 class=\"wp-block-heading screen-reader-text\">About</h1>\r\n\t\t\r\n\r\n\t\t\r\n\t\t<div class=\"wp-block-group cv-section-heading screen-reader-text is-nowrap is-layout-flex wp-container-core-group-is-layout-79fb870f wp-block-group-is-layout-flex\">\r\n\t\t\t\r\n\t\t\t<h2 class=\"wp-block-heading section-index\">Biography</h2>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\r\n\t\t\r\n\t\t<div class=\"wp-block-group cv-biography is-layout-flow wp-block-group-is-layout-flow\">\r\n\t\t\t\r\n\t\t\t<figure class=\"wp-block-image cv-biography__media\"><img src=\"/wp-content/themes/portfolio-theme/assets/images/cv/po-hao-chen-performance.webp\" alt=\"PO HAO CHEN performing live with electronic music equipment\" width=\"903\" height=\"1143\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\" /></figure>\r\n\t\t\t\r\n\r\n\t\t\t\r\n\t\t\t<div class=\"wp-block-group cv-biography__content is-layout-flow wp-block-group-is-layout-flow\">\r\n\t\t\t\t\r\n\t\t\t\t<h3 class=\"wp-block-heading cv-biography__name\">PO HAO CHEN</h3>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<p class=\"cv-biography__role wp-block-paragraph\">MUSIC PRODUCER / SOUND ARTIST</p>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<div class=\"wp-block-group cv-biography__copy is-layout-flow wp-block-group-is-layout-flow\">\r\n\t\t\t\t\t\r\n\t\t\t\t\t<p class=\"wp-block-paragraph\">A graduate of the Music Engineering Division of the Applied Music Department at Tainan National University of the Arts, PO HAO CHEN is a former music producer at Soft-World International Corporation and now works independently across scoring, music production, live performance, and interdisciplinary performance. Collaborations and productions include Madhead (Hong Kong) for Tower of Saviors, SEGA (Japan), TSG GhostHawks, TSG SkyHawks, the PTS Golden Vtuber Awards, and numerous VTubers and singers. In early 2026, PO HAO CHEN also served as music director for singer E1and&#x27;s special showcase, overseeing its overall music planning and show coordination.</p>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t<p class=\"wp-block-paragraph\">In recent years, PO HAO CHEN has been actively involved in sound art and interdisciplinary creation, including a performance at the C-LAB Sound Festival.</p>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t<p class=\"wp-block-paragraph\">Current work spans songwriting, arranging, vocal production, guitar and bass performance, audio editing, mixing, live music direction, live music / sound performance, sound design, creative coding, software development, and music teaching.</p>\r\n\t\t\t\t\t\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t</div>\r\n\t\r\n\r\n\t\r\n\t<div id=\"cv-placeholder\" class=\"wp-block-group alignwide editorial-section editorial-grid cv-timeline is-layout-flow wp-block-group-is-layout-flow\">\r\n\t\t\r\n\t\t<div class=\"wp-block-group cv-section-heading screen-reader-text is-nowrap is-layout-flex wp-container-core-group-is-layout-79fb870f wp-block-group-is-layout-flex\">\r\n\t\t\t\r\n\t\t\t<h2 class=\"wp-block-heading section-index\">Selected Experience</h2>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\r\n\t\t\r\n\t\t<div class=\"cv-arrangement\" data-cv-arrangement>\r\n\t\t\t<div class=\"cv-arrangement__pin\">\r\n\t\t\t\t<div class=\"cv-arrangement__stage\">\r\n\t\t\t\t\t<div class=\"cv-arrangement__view\">\r\n\t\t\t\t\t\t<div class=\"cv-arrangement__track\">\r\n\t\t\t\t\t\t<div class=\"cv-arrangement__block\" data-year=\"2026\">\r\n\t\t\t\t\t\t\t<h3 class=\"cv-experience__year\">2026</h3>\r\n\t\t\t\t\t\t\t<ul class=\"cv-experience__list\">\r\n\t\t\t\t\t\t\t\t<li class=\"cv-experience__row\"><span class=\"cv-experience__description\"><sp
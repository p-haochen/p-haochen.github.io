viewBox=\"0 0 18 12\" aria-hidden=\"true\" focusable=\"false\"><g fill=\"currentColor\"><circle cx=\"2.5\" cy=\"2\" r=\"1.35\"/><circle cx=\"6.8\" cy=\"2\" r=\"1.35\" opacity=\".45\"/><circle cx=\"11.1\" cy=\"2\" r=\"1.35\" opacity=\".8\"/><circle cx=\"15.4\" cy=\"2\" r=\"1.35\" opacity=\".3\"/><circle cx=\"2.5\" cy=\"6\" r=\"1.35\" opacity=\".6\"/><circle cx=\"6.8\" cy=\"6\" r=\"1.35\"/><circle cx=\"11.1\" cy=\"6\" r=\"1.35\" opacity=\".35\"/><circle cx=\"15.4\" cy=\"6\" r=\"1.35\" opacity=\".9\"/><circle cx=\"2.5\" cy=\"10\" r=\"1.35\" opacity=\".5\"/><circle cx=\"6.8\" cy=\"10\" r=\"1.35\" opacity=\".7\"/><circle cx=\"11.1\" cy=\"10\" r=\"1.35\"/><circle cx=\"15.4\" cy=\"10\" r=\"1.35\" opacity=\".4\"/></g></svg><span>LIVE</span><i></i><span>2025</span></p>\n\t\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">Boulder</h1><script type=\"application/json\" data-work-share-source>{\"url\":\"/en/works/boulder/\",\"title\":\"Boulder\",\"category\":\"LIVE\",\"year\":\"2025\",\"cover\":\"/wp-content/uploads/2026/08/boulder-cover.webp\",\"roles\":[\"Electronic Music Performance\"]}</script>\n\t\t\t</div>\n\t\t\t\n\n\t\t\t<section class=\"work-detail__section work-detail__section--description\" data-work-detail-section=\"ABOUT\" aria-labelledby=\"work-detail-section-description-27\"><h2 class=\"work-detail__label\" id=\"work-detail-section-description-27\"><span class=\"work-detail__label-text\">ABOUT</span></h2><div class=\"work-detail__section-body\"><div class=\"work-detail__post-content work-detail__description\"><h2 class=\"wp-block-heading screen-reader-text\">Description</h2>\n<p class=\"wp-block-paragraph\">Created with game engines, Boulder is an audiovisual performance about labor, the artificial and the natural, the organic and the inorganic. Figures wander, push boulders, and hesitate—mirroring humanity in miniature. Combining game engines, computer music, and immersive sound technologies, Boulder seeks to deconstruct and reconstruct related contemporary issues, offering modern individuals a space to rethink their own existence, guiding the audience to drift between technological narratives and body perception.</p>\n</div></div></section>\n\t\t\t\n\t\t\t<section class=\"work-detail__section work-detail__section--watch\" data-work-detail-section=\"WATCH\" aria-labelledby=\"work-detail-section-watch-27\"><h2 class=\"work-detail__label\" id=\"work-detail-section-watch-27\"><span class=\"work-detail__label-text\">WATCH</span></h2><div class=\"work-detail__section-body\"><div class=\"work-media work-media--watch\"><section class=\"work-media__section work-media-embed work-media-embed--youtube\" aria-labelledby=\"work-media-youtube-27\"><h2 id=\"work-media-youtube-27\" class=\"work-media__heading\">Video</h2><div class=\"work-media-embed__frame work-media-embed__frame--youtube\"><button type=\"button\" class=\"work-youtube\" data-youtube-id=\"7SytxVh0VYo\" data-youtube-src=\"https://www.youtube.com/embed/7SytxVh0VYo\" data-youtube-title=\"Boulder — YouTube video\" aria-label=\"Play video: Boulder\"><img class=\"work-youtube__poster\" src=\"https://i.ytimg.com/vi/7SytxVh0VYo/maxresdefault.jpg\" data-youtube-fallback=\"https://i.ytimg.com/vi/7SytxVh0VYo/hqdefault.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\"><span class=\"work-youtube__play\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" focusable=\"false\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></span></button><noscript><a class=\"work-youtube__link\" href=\"https://www.youtube.com/watch?v=7SytxVh0VYo\" target=\"_blank\" rel=\"noopener noreferrer\">Watch on YouTube: Boulder</a></noscript></div></section></div></div></section>\n\t\t\t<section class=\"work-detail__section work-detail__section--credits\" data-work-detail-section=\"CREDITS\" aria-labelledby=\"work-detail-section-credits-27\"><h2 class=\"work-detail__label\" id=\"work-detail-section-credits-27\"><span class=\"work-detail__l
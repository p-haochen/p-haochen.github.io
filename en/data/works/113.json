    "seo": {
      "title": "Holographic Utopia: After the Age of 80 | PO HAO CHEN",
      "description": "Holographic Utopia: After the Age of 80 — PO HAO CHEN: MUSIC PRODUCTION, COMPOSITION, ARRANGEMENT, KEYS / SYNTH, MIXING, AUDIO EDITING. 2025 · MUSIC / LIVE · PERFORMANCE SCORE / INSTALLATION MUSIC / LIVE PERFORMANCE / INTERACTIVE INSTALLATION.",
      "canonical_url": "/en/works/holographic-utopia-after-80/",
      "image_url": "/wp-content/uploads/2026/08/holographic-utopia-after-80-cover-1024x683.webp",
      "og_type": "article",

"2\" r=\"1.35\" opacity=\".45\"/><circle cx=\"11.1\" cy=\"2\" r=\"1.35\" opacity=\".8\"/><circle cx=\"15.4\" cy=\"2\" r=\"1.35\" opacity=\".3\"/><circle cx=\"2.5\" cy=\"6\" r=\"1.35\" opacity=\".6\"/><circle cx=\"6.8\" cy=\"6\" r=\"1.35\"/><circle cx=\"11.1\" cy=\"6\" r=\"1.35\" opacity=\".35\"/><circle cx=\"15.4\" cy=\"6\" r=\"1.35\" opacity=\".9\"/><circle cx=\"2.5\" cy=\"10\" r=\"1.35\" opacity=\".5\"/><circle cx=\"6.8\" cy=\"10\" r=\"1.35\" opacity=\".7\"/><circle cx=\"11.1\" cy=\"10\" r=\"1.35\"/><circle cx=\"15.4\" cy=\"10\" r=\"1.35\" opacity=\".4\"/></g></svg><span>LIVE</span><i></i><span>2026</span></p>\n\t\t\t\t<h1 class=\"work-detail__title wp-block-post-title\">E1and Special Showcase WONDE1AND</h1><script type=\"application/json\" data-work-share-source>{\"url\":\"/en/works/wonde1and/\",\"title\":\"E1and Special Showcase WONDE1AND\",\"category\":\"LIVE\",\"year\":\"2026\",\"cover\":\"/wp-content/uploads/2026/08/wonde1and-cover.webp\",\"roles\":[\"Music Director\",\"Programmer\",\"Band Leader\",\"Arranger\",\"Stage Manager\"]}</script>\n\t\t\t</div>\n\t\t\t\n\n\t\t\t<section class=\"work-detail__section work-detail__section--description\" data-work-detail-section=\"ABOUT\" aria-labelledby=\"work-detail-section-description-26\"><h2 class=\"work-detail__label\" id=\"work-detail-section-description-26\"><span class=\"work-detail__label-text\">ABOUT</span></h2><div class=\"work-detail__section-body\"><div class=\"work-detail__post-content work-detail__description\"><h2 class=\"wp-block-heading screen-reader-text\">Description</h2>\n<p class=\"wp-block-paragraph\">An immersive, up-close experimental small-scale showcase that feels like stepping into a room.</p>\n\n<p class=\"wp-block-paragraph\">With the stage designed by E1and herself,</p>\n\n<p class=\"wp-block-paragraph\">it blends a live band set with a DJ-style after-party to show her many sides.</p>\n\n<p class=\"wp-block-paragraph\">Its concept draws on Alice in Wonderland —</p>\n\n<p class=\"wp-block-paragraph\">song by song, like drawing back a lace curtain, it leads listeners into her most honest inner world,</p>\n\n<p class=\"wp-block-paragraph\">telling of her attachment to this city, her contradictions, her loneliness and her inspiration.</p>\n\n<p class=\"wp-block-paragraph\">This show wants to say to everyone who has ever felt alienated for being different:</p>\n\n<p class=\"wp-block-paragraph\">you are invited to feel freely in this space and simply enjoy yourself.</p>\n</div></div></section>\n\t\t\t\n\t\t\t\n\t\t\t<section class=\"work-detail__section work-detail__section--credits\" data-work-detail-section=\"CREDITS\" aria-labelledby=\"work-detail-section-credits-26\"><h2 class=\"work-detail__label\" id=\"work-detail-section-credits-26\"><span class=\"work-detail__label-text\">CREDITS</span></h2><div class=\"work-detail__section-body\"><section class=\"work-detail__credits\" aria-labelledby=\"work-detail-credits-26\"><h2 id=\"work-detail-credits-26\" class=\"work-media__heading\">Credits</h2><dl id=\"work-credits-list-26\" class=\"work-credits work-credits--long is-collapsed\"><div class=\"work-credits__row\"><dt>Music Director</dt><dd>PO HAO CHEN</dd></div>\n<div class=\"work-credits__row\"><dt>Electric Guitar</dt><dd>Yu-Hsuan Jen</dd></div>\n<div class=\"work-credits__row\"><dt>Acoustic Guitar</dt><dd>Chung-En Wei</dd></div>\n<div class=\"work-credits__row\"><dt>Bass</dt><dd>Chung-En Wei</dd></div>\n<div class=\"work-credits__row\"><dt>Keyboards</dt><dd>Yen-Cheng Chen</dd></div>\n<div class=\"work-credits__row\"><dt>Programmer</dt><dd>PO HAO CHEN</dd></div>\n<div class=\"work-credits__row\"><dt>Band Leader</dt><dd>PO HAO CHEN</dd></div>\n<div class=\"work-credits__row\"><dt>Arranger</dt><dd>PO HAO CHEN</dd></div>\n<div class=\"work-credits__row\"><dt>Additional Arrangement</dt><dd>Chung-En Wei</dd></div>\n<div class=\"work-credits__row\"><dt>Art Design</dt><dd>Pin-Cheng Li</dd></div>\n<div class=\"work-credits__row\"><dt>Equipment Support</dt><dd>puzzleman, Ko-Cheng Liu</dd></div>\n<div class=\"work-credits__row\"><dt>Hardware Coordination</dt><dd>Yaohuan Ltd.</dd></div>\n<div class=\"work-credits__row\"><dt>Sound Engineering</dt><dd>HANDONG PRODUCTION GROUP CO. LTD.</dd></div>\n<div class=\"work-credits__row\"><dt>Lighting Engineering</dt><dd>Dollar Studio</dd></div>\n<div class=\"work-credits__row\"><dt>Stage Manager</dt><dd>PO HAO CHEN</dd></div>\n<div class=\"work-credits__row\"><dt>Coordination Consultant / Backstage Assistant</dt><dd>I-Shan Mao</dd></div>\n<div class=\"work-credits__row\"><dt>On-site Support</dt><dd>Hung-Yu Kao, Pei-Ju Liu</dd></div>\n<div class=\"work-credits__row\"><dt>Guest Performers</dt><dd>Jo-Hsin Huang, Sha-Sha Lo, RedLee</dd></div>\n<div class=\"work-credits__row\"><dt>Technical Support</dt><dd>Yung-Jen Huang</dd></div>\n<div class=\"work-credits__row\"><dt>Photography Support</dt><dd>Aron, Yu-Tsang Hsiao</dd></div>\n<div class=\"work-credits__row\"><dt>PR &amp; Marketing</dt><dd>Boris</dd></div>\n<div class=\"work-credits__row\"><dt>Assistant to the Music Director</dt><dd>Yung-Jen Huang</dd></div>\n<div class=\"work-credits__row\"><dt>Executive Coordinator</dt><dd>Boris</dd></div>\n<div class=\"work-credits__row\"><dt>Venue</dt><dd>GOLDEN CAVE CAFE</dd></div>\n<div class=\"work-credits__row\"><dt>Supporting Sponsor</dt><dd>Sleepy Tofu</dd></div>\n</dl><button type=\"button\" class=\"work-credits__toggle\" data-work-credits-toggle aria-controls=\"work-credits-list-26\" aria-expanded=\"false\" data-label-more=\"Show all 25\" data-label-less=\"Show less\">Show all 25</button></section></div></section>\n\t\t\t<section class=\"work-detail__section work-detail__section--gallery\" data-work-detail-section=\"GALLERY\" aria-labelledby=\"work-detail-section-gallery-26\"><h2 class=\"work-detail__label\" id=\"work-detail-section-gallery-26\"><span class=\"work-detail__label-text\">GALLERY</span></h2><div class=\"work-detail__section-body\"><div class=\"work-media work-media--gallery\"><sectio